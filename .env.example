# Rio Casa — environment template.
#
# Copy to `.env.local` and fill in real values:  cp .env.example .env.local
# Everything marked REQUIRED must be set in the Vercel project too. The four
# secrets below fail *shut* when missing (see CLAUDE.md) rather than falling
# back to a committed default — that is deliberate, not a bug to work around.

# ─── Database ───────────────────────────────────────────────
# REQUIRED. Neon in production. Use the direct (non `-pooler`) endpoint for DDL.
DATABASE_URL=postgresql://user:password@localhost:5432/rio_casa
# Optional, default 20. Must parse as a number or the pool silently reverts (B-56).
DATABASE_POOL_MAX=20

# ─── Razorpay ────────────────────────────────────────────────
# REQUIRED. From the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Resend (email) ──────────────────────────────────────────
# Booking confirmations, invoices, contact notifications. Unset disables all
# three — every send site treats mail as best-effort and logs the failure.
RESEND_API_KEY=
EMAIL_FROM=bookings@riocasa.in
EMAIL_RESORT=info@riocasa.in

# ─── App ─────────────────────────────────────────────────────
# REQUIRED in production: the WhatsApp button falls back to a placeholder
# number when unset, sending guests to a stranger. Country code, no `+`.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# REQUIRED in production. Canonical origin, no trailing slash. Feeds
# metadataBase, every canonical tag, the Open Graph URLs, sitemap.xml and
# robots.txt. Wrong here means search engines are pointed at the wrong host.
NEXT_PUBLIC_SITE_URL=https://riocasa.in

# Optional. Emitted as `geo` in the property's schema.org data, which is what
# puts the right pin on a map result. Both must be set, or geo is omitted
# entirely — a plausible guess is worse than nothing here.
NEXT_PUBLIC_HOTEL_LATITUDE=
NEXT_PUBLIC_HOTEL_LONGITUDE=

# ─── JWT (admin auth) ────────────────────────────────────────
# REQUIRED in production — without it every login 500s and every session 401s,
# on purpose. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Cron jobs ───────────────────────────────────────────────
# REQUIRED in production — every cron route returns 503 without it.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Booking holds ───────────────────────────────────────────
# How long an unpaid website booking keeps its room before
# /api/cron/expire-holds releases it. Optional; defaults to 60.
BOOKING_HOLD_MINUTES=60

# ─── GST invoicing ───────────────────────────────────────────
# REQUIRED in production. HOTEL_GSTIN is snapshotted onto every tax invoice at
# check-out, so it cannot be corrected afterwards by changing this value —
# existing rows need prisma/repair-invoice-gstin.ts (B-62). Invoice generation
# refuses outright in production when this is unset, still the placeholder, or
# malformed; check-out itself completes either way.
HOTEL_GSTIN=
HOTEL_NAME=Rio Casa Resort
HOTEL_ADDRESS=Mahabaleshwar, Satara District, Maharashtra - 412806

# ─── Channel manager (eZee Centrix) ──────────────────────────
# Unused. /api/cron/pull-ota is deliberately unscheduled — this property does
# not use eZee. See CHANNEL-MANAGER-PLAN.md.
EZEE_API_URL=
EZEE_API_KEY=

# ─── Dev tooling ─────────────────────────────────────────────
# Passwords for `node scripts/shot.mjs`, which logs into the admin panel to
# screenshot it. Printed once by `npm run seed:admin`. Local only — never set
# these in a deployed environment.
SHOT_OWNER_PASSWORD=
SHOT_MANAGER_PASSWORD=
SHOT_FRONTDESK_PASSWORD=
SHOT_HOUSEKEEPING_PASSWORD=
